{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinscout",
  "compatibility_date": "2026-09-11",
  "main": "src/worker.ts",
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "vinscout-worker"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
