{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinscout",
  "compatibility_date": "2026-09-11",
  "main": "src/worker.ts",
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://vinscout-worker.johnbroberts.workers.dev"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
